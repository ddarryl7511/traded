# Copy to /etc/systemd/system/ and adjust User and paths if your user is not "pi"
# or the project is not in /home/pi/traded.
[Unit]
Description=Momentum research bot (Alpaca PAPER only): data update, signal, rebalance
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/traded
EnvironmentFile=/home/pi/traded/.env
ExecStart=/home/pi/traded/.venv/bin/python -m momentum_bot run
# Optional: notify on failure of the whole job (uses the same webhook as the bot).
# ExecStopPost=/bin/sh -c '[ "$SERVICE_RESULT" = success ] || curl -fsS -d "momentum-bot job failed" "$NOTIFY_WEBHOOK_URL"'
TimeoutStartSec=45min
Nice=10
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/traded/data /home/pi/traded/reports /home/pi/traded/logs
